import huevosDePascua.*
import caceriaDeHuevos.*
import chicosYChichas.*



describe "caceria de huevos" {

  method inicializar(){
    caceria.iniciarJuego()
  }

  test "el de mayor calorias es la matrioshka" {
    caceria.iniciarJuego()
    assert.equals(matrioshka, caceria.huevoNoEncontradoConLaMayorCaloria())
  }

  test "test general " {
    caceria.encontrarElPrimerHuevoPor(ana)
    assert.equals(3, caceria.huevosNoEncontrados())
    assert.equals(2, caceria.huevosNoEncontradosConChocolateBlanco())
    assert.that(caceria.huevoAunNoEncontrado(conejo))
    assert.equals([huevoRepostero, huevoMixto], caceria.huevosNoEncontradosBlancos())
    caceria.encontrarUnHuevoPor(tito, huevoMixto)
    caceria.encontrarLosHuevosRestantes(jose)
    assert.that(ana.estaEnfermo())
    assert.that(jose.estaEnfermo())
  }

}